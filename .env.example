# Copy to .env for local overrides. Never commit .env.
# Core demo runs with these defaults and does not need an API key.

AUTORO_ENV=local
AUTORO_DATA_DIR=./backend/data/runtime
# Leave empty for the SQLite adapter. Example MongoDB URL (optional):
# AUTORO_DATABASE_URL=mongodb://localhost:27017
AUTORO_MONGO_DB=autoro

# demo | ollama | openai_compatible | mlx
AUTORO_PROVIDER=demo
# deterministic_demo | ollama | none
AUTORO_TEACHER_PROVIDER=deterministic_demo

AUTORO_OLLAMA_BASE_URL=http://127.0.0.1:11434
AUTORO_OLLAMA_MODEL=llama3.2:1b
AUTORO_OLLAMA_TIMEOUT_SECONDS=60

# Optional OpenAI-compatible endpoint. Leave blank. The key stays server-side.
# AUTORO_OPENAI_COMPAT_BASE_URL=https://example.invalid/v1
# AUTORO_OPENAI_COMPAT_API_KEY=
# AUTORO_OPENAI_COMPAT_MODEL=

AUTORO_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
AUTORO_LOG_LEVEL=INFO
AUTORO_MAX_EXTRACT_CHARS=8000
AUTORO_MAX_QUESTION_CHARS=1000
AUTORO_RATE_LIMIT_PER_MINUTE=60
AUTORO_JOBS_INLINE=0
AUTORO_RETRIEVAL_MODE=hybrid
AUTORO_BM25_MIN_SCORE=0.15
AUTORO_MAX_SYNTHETIC_COUNT=20
AUTORO_NHTSA_MAX_RECORDS=50
AUTORO_NHTSA_TIMEOUT_SECONDS=30
AUTORO_DOWNLOAD_MAX_BYTES=30000000

# Optional Apple Silicon MLX LoRA. Not used by the demo provider.
# AUTORO_MLX_MODEL=mlx-community/Llama-3.2-1B-Instruct-4bit
# AUTORO_MLX_ITERS=20
